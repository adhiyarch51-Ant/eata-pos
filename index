<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eat A Bakery - Sales & POS Dashboard</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js for analytics dashboard charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS for Export to Excel -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dashBg: '#FAF6F0',
                        brandBlue: '#6B3E2E',
                        brandLightBlue: '#F3ECE1',
                        emeraldSuccess: '#D97706',
                        sidebarActive: '#EFE5D8',
                        sidebarText: '#5A463B',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #FAF6F0; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #F3ECE1; }
        ::-webkit-scrollbar-thumb { background: #D4C4B5; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #A89280; }
        .card-shadow { box-shadow: 0 4px 20px -2px rgba(107, 62, 46, 0.08); }
        
        @media print {
            .no-print { display: none !important; }
            #receipt-modal-content { display: block !important; }
        }
    </style>
</head>
<body class="font-sans text-stone-800 antialiased h-screen flex flex-col md:flex-row overflow-hidden selection:bg-amber-700 selection:text-white">

    <!-- MOBILE TOP BAR (Tampil hanya di layar HP/Mobile) -->
    <div class="md:hidden bg-[#FFFDF9] border-b border-amber-900/10 px-4 py-3 flex items-center justify-between z-30 shrink-0 no-print">
        <div class="flex items-center space-x-2.5">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#6B3E2E] to-[#B45309] text-amber-100 flex items-center justify-center font-bold text-sm shadow-sm">
                <i data-lucide="cupcake" class="w-4 h-4 text-amber-100"></i>
            </div>
            <div>
                <h1 class="font-bold text-stone-900 text-sm leading-tight">Eat A Bakery</h1>
                <p class="text-[9px] text-amber-800/60 font-medium">POS Kasir Roti</p>
            </div>
        </div>
        <button onclick="toggleMobileMenu()" class="p-2 bg-stone-100 text-stone-700 rounded-lg hover:bg-stone-200 active:scale-95 transition-all">
            <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
    </div>

    <!-- LEFT SIDEBAR NAV (Desktop Full Sidebar / Mobile Drawer) -->
    <aside id="main-sidebar" class="hidden md:flex w-full md:w-64 bg-[#FFFDF9] border-r border-amber-900/10 flex-col justify-between z-40 shrink-0 no-print absolute md:relative inset-y-0 left-0 shadow-2xl md:shadow-none transition-all duration-300">
        <div>
            <!-- Header Logo (Modern App Brand + Bakery Icon style accent) -->
            <div class="p-5 border-b border-amber-900/10 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#6B3E2E] to-[#B45309] text-amber-100 flex items-center justify-center font-bold text-xl shadow-md shadow-amber-900/20">
                        <i data-lucide="cupcake" class="w-5 h-5 text-amber-100"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-stone-900 text-base leading-tight">Eat A Bakery</h1>
                        <p class="text-[11px] text-amber-800/60 font-medium">Soft Sourdough POS</p>
                    </div>
                </div>
                <button onclick="toggleMobileMenu()" class="md:hidden text-stone-400 hover:text-stone-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="p-3 space-y-1.5 text-xs font-semibold">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all bg-[#F3ECE1] text-[#6B3E2E] font-bold shadow-sm">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 text-[#6B3E2E]"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="switchTab('pos')" id="nav-pos" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-stone-600 hover:bg-stone-100 hover:text-stone-900">
                    <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                    <span>Sales (Kasir POS)</span>
                </button>
                <button onclick="switchTab('inventory')" id="nav-inventory" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-stone-600 hover:bg-stone-100 hover:text-stone-900">
                    <i data-lucide="package" class="w-4 h-4"></i>
                    <span>Stok Produk Roti</span>
                </button>
                <button onclick="switchTab('raw-materials')" id="nav-raw-materials" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-stone-600 hover:bg-stone-100 hover:text-stone-900">
                    <i data-lucide="boxes" class="w-4 h-4"></i>
                    <span>Stok Bahan Baku</span>
                </button>
                <button onclick="switchTab('reports')" id="nav-reports" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-stone-600 hover:bg-stone-100 hover:text-stone-900">
                    <i data-lucide="receipt" class="w-4 h-4"></i>
                    <span>Keuangan & Riwayat</span>
                </button>
                <button onclick="switchTab('integrations')" id="nav-integrations" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-stone-600 hover:bg-stone-100 hover:text-stone-900">
                    <i data-lucide="cloud-cog" class="w-4 h-4 text-amber-700"></i>
                    <span>Integrasi Cloud & Sync</span>
                </button>
                <button onclick="exportToExcel()" class="w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl transition-all text-emerald-800 hover:bg-emerald-50">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-700"></i>
                    <span>Export Excel Report</span>
                </button>
            </nav>
        </div>

        <!-- Bakery Contact / Info Footer -->
        <div class="p-4 m-3 bg-[#F8F2E8] rounded-2xl border border-amber-900/10 text-[11px] text-stone-600 space-y-1">
            <div class="flex items-center gap-1.5 font-semibold text-stone-800">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#B45309]"></i> Sambi, Boyolali
            </div>
            <p class="text-[10px] text-stone-500">WA: 085647052540</p>
            <p class="text-[9px] text-[#B45309] font-bold pt-1">✨ 100% Ragi Alami • Sourdough</p>
        </div>
    </aside>

    <!-- MAIN RIGHT CONTENT WRAPPER -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
        
        <!-- Top App Bar (Sembunyi di HP kecil) -->
        <header class="hidden md:flex h-16 bg-[#FFFDF9] border-b border-amber-900/10 px-6 items-center justify-between shrink-0 no-print">
            <div class="flex items-center space-x-3">
                <h2 id="page-title" class="font-bold text-xl text-stone-900">Sales Dashboard</h2>
                <span class="text-xs font-semibold px-2.5 py-1 bg-amber-50 text-amber-800 rounded-full border border-amber-200">Live Status</span>
            </div>
            
            <div class="flex items-center space-x-4">
                <button onclick="switchTab('pos')" class="px-4 py-2 bg-[#6B3E2E] hover:bg-[#532E22] text-amber-50 rounded-xl font-bold text-xs shadow-md shadow-amber-900/20 flex items-center gap-2 transition-all">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i> Transaksi Kasir Baru
                </button>
            </div>
        </header>

        <!-- Dynamic Content Body -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 space-y-6 pb-20 md:pb-6">
            
            <!-- SECTION 1: SALES DASHBOARD (Analytics) -->
            <div id="section-dashboard" class="space-y-6">
                
                <!-- TOP KPI METRIC CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                    
                    <!-- KPI 1: Total Penjualan -->
                    <div class="bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-stone-400">Total Penjualan</p>
                            <h3 id="dash-total-sales" class="text-2xl font-bold text-stone-900 mt-1">Rp 0</h3>
                            <div class="flex items-center gap-1 text-xs font-bold text-emerald-700 mt-2">
                                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                                <span>0%</span>
                                <span class="text-stone-400 font-normal text-[11px] ml-1">hari ini</span>
                            </div>
                        </div>
                        <div class="p-3 bg-amber-50 text-[#6B3E2E] rounded-xl">
                            <i data-lucide="dollar-sign" class="w-5 h-5"></i>
                        </div>
                    </div>

                    <!-- KPI 2: Total Order -->
                    <div class="bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-stone-400">Total Order</p>
                            <h3 id="dash-total-orders" class="text-2xl font-bold text-stone-900 mt-1">0</h3>
                            <div class="flex items-center gap-1 text-xs font-bold text-amber-700 mt-2">
                                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                                <span>0%</span>
                                <span class="text-stone-400 font-normal text-[11px] ml-1">hari ini</span>
                            </div>
                        </div>
                        <div class="p-3 bg-stone-100 text-[#B45309] rounded-xl">
                            <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                        </div>
                    </div>

                    <!-- KPI 3: Total Customer -->
                    <div class="bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-stone-400">Total Customer</p>
                            <h3 id="dash-total-customers" class="text-2xl font-bold text-stone-900 mt-1">0</h3>
                            <div class="flex items-center gap-1 text-xs font-bold text-amber-700 mt-2">
                                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                                <span>0%</span>
                                <span class="text-stone-400 font-normal text-[11px] ml-1">hari ini</span>
                            </div>
                        </div>
                        <div class="p-3 bg-emerald-50 text-emerald-700 rounded-xl">
                            <i data-lucide="users" class="w-5 h-5"></i>
                        </div>
                    </div>

                </div>

                <!-- MIDDLE ROW: CHARTS (Bar/Line & Donut) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    
                    <!-- Penjualan Bulanan (7 Cols) -->
                    <div class="lg:col-span-7 bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow space-y-4">
                        <div class="flex justify-between items-center">
                            <h3 class="font-bold text-stone-900 text-base">Penjualan Bulanan</h3>
                            <div class="flex items-center space-x-3 text-xs font-semibold">
                                <span class="flex items-center gap-1 text-[#6B3E2E]"><span class="w-2.5 h-2.5 rounded-full bg-[#6B3E2E] inline-block"></span> 2025</span>
                                <span class="flex items-center gap-1 text-[#D97706]"><span class="w-2.5 h-2.5 rounded-full bg-[#D97706] inline-block"></span> 2026</span>
                            </div>
                        </div>
                        <div class="h-64">
                            <canvas id="monthlySalesChart"></canvas>
                        </div>
                    </div>

                    <!-- Penjualan per Kategori (5 Cols) -->
                    <div class="lg:col-span-5 bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow space-y-4">
                        <h3 class="font-bold text-stone-900 text-base">Penjualan per Kategori</h3>
                        <div class="h-64 flex items-center justify-center">
                            <canvas id="categoryPieChart"></canvas>
                        </div>
                    </div>

                </div>

                <!-- BOTTOM ROW: TOP PRODUK & TREN PENJUALAN -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    
                    <!-- Top Produk (6 Cols) -->
                    <div class="lg:col-span-6 bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow space-y-4">
                        <h3 class="font-bold text-stone-900 text-base">Top Produk Sourdough</h3>
                        <div id="top-products-list" class="space-y-3.5 text-xs">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Tren Penjualan Multi-Line (6 Cols) -->
                    <div class="lg:col-span-6 bg-[#FFFDF9] p-5 rounded-2xl border border-amber-900/10 card-shadow space-y-4">
                        <div class="flex justify-between items-center">
                            <h3 class="font-bold text-stone-900 text-base">Tren Penjualan</h3>
                            <div class="flex items-center space-x-3 text-xs font-semibold">
                                <span class="text-[#6B3E2E]">— 2025</span>
                                <span class="text-[#D97706]">— 2026</span>
                            </div>
                        </div>
                        <div class="h-56">
                            <canvas id="trendSalesChart"></canvas>
                        </div>
                    </div>

                </div>

            </div>

            <!-- SECTION 2: POS KASIR -->
            <div id="section-pos" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- Left: Catalog (7 Cols) -->
                <div class="lg:col-span-7 flex flex-col gap-4">
                    <div class="bg-[#FFFDF9] p-3 md:p-4 rounded-2xl border border-amber-900/10 card-shadow flex flex-col sm:flex-row gap-3">
                        <div class="relative flex-1">
                            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400"></i>
                            <input type="text" id="search-input" oninput="renderProducts()" placeholder="Cari Varian Soft Sourdough..." class="w-full pl-10 pr-4 py-2 bg-[#FAF6F0] border border-amber-900/10 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-amber-800/20 focus:border-amber-700">
                        </div>
                        <div class="flex gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="category-filters">
                            <!-- Categories -->
                        </div>
                    </div>

                    <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 md:gap-4">
                        <!-- Products Grid -->
                    </div>
                </div>

                <!-- Right: Cart & Checkout (5 Cols) -->
                <div class="lg:col-span-5 bg-[#FFFDF9] rounded-2xl border border-amber-900/10 card-shadow flex flex-col lg:h-[calc(100vh-8.5rem)] lg:sticky top-4 overflow-hidden">
                    <div class="p-4 border-b border-amber-900/10 flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 text-[#6B3E2E] flex items-center justify-center font-bold">
                                <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                            </div>
                            <h3 class="font-bold text-stone-900 text-sm">Pesanan Kasir</h3>
                        </div>
                        <button onclick="clearCart()" class="text-xs text-rose-600 hover:bg-rose-50 px-2 py-1 rounded-lg font-semibold">Reset</button>
                    </div>

                    <div id="cart-items" class="flex-1 overflow-y-auto p-4 divide-y divide-amber-900/5 max-h-60 lg:max-h-none">
                        <!-- Items -->
                    </div>

                    <div class="p-4 bg-[#F8F2E8] border-t border-amber-900/10 space-y-3">
                        <div class="space-y-1.5 text-xs text-stone-600">
                            <div class="flex justify-between">
                                <span>Subtotal</span>
                                <span id="summary-subtotal" class="font-bold text-stone-800">Rp 0</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="flex items-center gap-1">
                                    Diskon
                                    <select id="discount-type" onchange="updateCalculations()" class="text-[10px] bg-white border border-amber-900/20 rounded px-1 py-0.5 font-bold">
                                        <option value="percent">%</option>
                                        <option value="nominal">Rp</option>
                                    </select>
                                    <input type="number" id="input-discount" value="0" min="0" oninput="updateCalculations()" class="w-14 px-1.5 py-0.5 border border-amber-900/20 rounded text-center text-xs font-bold outline-none">
                                </span>
                                <span id="summary-discount" class="text-amber-700 font-bold">- Rp 0</span>
                            </div>
                            <div class="flex justify-between text-base font-bold text-stone-900 pt-2 border-t border-amber-900/10">
                                <span>Total Tagihan</span>
                                <span id="summary-total" class="text-[#6B3E2E] font-extrabold text-lg">Rp 0</span>
                            </div>
                        </div>

                        <!-- Payment method toggle -->
                        <div class="grid grid-cols-3 gap-1.5 pt-1">
                            <button type="button" onclick="setPaymentMethod('cash')" id="pay-cash" class="py-1.5 border border-[#6B3E2E] bg-[#F3ECE1] text-[#6B3E2E] font-bold rounded-lg text-xs">Tunai</button>
                            <button type="button" onclick="setPaymentMethod('qris')" id="pay-qris" class="py-1.5 border border-stone-200 hover:bg-stone-100 text-stone-600 font-semibold rounded-lg text-xs">QRIS</button>
                            <button type="button" onclick="setPaymentMethod('transfer')" id="pay-transfer" class="py-1.5 border border-stone-200 hover:bg-stone-100 text-stone-600 font-semibold rounded-lg text-xs">Transfer</button>
                        </div>

                        <div id="cash-input-container" class="space-y-1.5">
                            <div class="flex gap-2">
                                <input type="number" id="input-cash" min="0" oninput="updateCalculations()" placeholder="Bayar Tunai (Rp)..." class="flex-1 px-3 py-2 bg-white border border-amber-900/20 rounded-xl text-xs font-bold text-stone-900 outline-none">
                                <button onclick="setExactCash()" class="px-3 py-2 bg-stone-200 hover:bg-stone-300 rounded-xl text-xs font-bold text-stone-800">Uang Pas</button>
                            </div>
                            <div class="flex justify-between items-center text-xs px-1">
                                <span class="text-stone-500">Kembalian:</span>
                                <span id="summary-change" class="font-bold text-stone-800 text-sm">Rp 0</span>
                            </div>
                        </div>

                        <button id="btn-checkout" onclick="processCheckout()" disabled class="w-full py-3 bg-[#6B3E2E] hover:bg-[#532E22] disabled:bg-stone-300 disabled:cursor-not-allowed text-white font-bold rounded-xl shadow-lg transition-all text-xs tracking-wider uppercase flex items-center justify-center gap-2">
                            <i data-lucide="printer" class="w-4 h-4"></i> Proses & Cetak Struk
                        </button>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: INVENTORY MANAGEMENT -->
            <div id="section-inventory" class="hidden bg-[#FFFDF9] rounded-2xl border border-amber-900/10 card-shadow p-6 space-y-5">
                <div class="flex justify-between items-center border-b border-amber-900/10 pb-4">
                    <div>
                        <h3 class="font-bold text-stone-900 text-lg">Inventory & Stok Soft Sourdough</h3>
                        <p class="text-xs text-stone-400">Atur ketersediaan menu roti harian & update foto produk toko Eat A</p>
                    </div>
                    <button onclick="openProductModal()" class="px-4 py-2 bg-[#6B3E2E] hover:bg-[#532E22] text-white font-bold text-xs rounded-xl transition-all flex items-center gap-1.5 shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i> Tambah Varian Roti
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-[#F8F2E8] text-stone-500 font-semibold uppercase text-[10px]">
                            <tr>
                                <th class="p-3.5 rounded-l-xl">Nama Varian & Foto</th>
                                <th class="p-3.5">Kategori</th>
                                <th class="p-3.5">Harga</th>
                                <th class="p-3.5">Stok Available</th>
                                <th class="p-3.5 text-right rounded-r-xl">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-table" class="divide-y divide-amber-900/5">
                            <!-- JS Populated -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 3.5: RAW MATERIALS MANAGEMENT (BAHAN BAKU & RESEP) -->
            <div id="section-raw-materials" class="hidden bg-[#FFFDF9] rounded-2xl border border-amber-900/10 card-shadow p-6 space-y-5">
                <div class="flex justify-between items-center border-b border-amber-900/10 pb-4">
                    <div>
                        <h3 class="font-bold text-stone-900 text-lg">Stok Bahan Baku & Resep Otomatis</h3>
                        <p class="text-xs text-stone-400">Setiap transaksi di kasir akan memotong bahan baku di bawah ini secara real-time</p>
                    </div>
                    <button onclick="openMaterialModal()" class="px-4 py-2 bg-[#B45309] hover:bg-[#92400E] text-white font-bold text-xs rounded-xl transition-all flex items-center gap-1.5 shadow-sm">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Tambah Bahan Baku
                    </button>
                </div>

                <!-- Alert Warning Banner -->
                <div id="low-stock-alert" class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 text-xs flex items-center gap-2 hidden">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0"></i>
                    <span id="low-stock-text" class="font-semibold">Beberapa bahan baku berada di bawah batas minimum stok! Segera lakukan restock.</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-[#F8F2E8] text-stone-500 font-semibold uppercase text-[10px]">
                            <tr>
                                <th class="p-3.5 rounded-l-xl">Nama Bahan Baku</th>
                                <th class="p-3.5">Kategori</th>
                                <th class="p-3.5">Stok Saat Ini</th>
                                <th class="p-3.5">Batas Minimum</th>
                                <th class="p-3.5">Status</th>
                                <th class="p-3.5 text-right rounded-r-xl">Aksi Restock</th>
                            </tr>
                        </thead>
                        <tbody id="raw-materials-table" class="divide-y divide-amber-900/5">
                            <!-- JS Populated -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 4: FINANCIAL REPORTS & HISTORY -->
