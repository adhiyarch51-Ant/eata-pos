        // Auto Sync Live Transaction to Google Sheet
        async function sendToGoogleSheet(tx) {
            const url = localStorage.getItem('eata_gsheet_url');
            if (!url) return;

            try {
                const payload = {
                    id: tx.id,
                    date: tx.date,
                    method: tx.method.toUpperCase(),
                    total: tx.total,
                    items: tx.items.map(i => `${i.name} (${i.qty}x)`).join(', ')
                };

                await fetch(url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            } catch (err) {
                console.error('GSheet Sync Error:', err);
            }
        }

        // Sync Data Backup to GitHub File (data_backup.json)
        async function syncToGitHub() {
            const token = localStorage.getItem('eata_gh_token');
            const repo = localStorage.getItem('eata_gh_repo');
            const branch = localStorage.getItem('eata_gh_branch') || 'main';

            if (!token || !repo) return alert('Lengkapi Personal Access Token & Repo Name GitHub terlebih dahulu!');

            const backupData = {
                timestamp: new Date().toISOString(),
                products: products,
                rawMaterials: rawMaterials,
                transactions: transactions
            };

            const contentEncoded = btoa(unescape(encodeURIComponent(JSON.stringify(backupData, null, 2))));
            const filePath = 'eata_pos_data_backup.json';
            const apiUrl = `https://api.github.com/repos/${repo}/contents/${filePath}`;

            try {
                // Get existing file sha if exists
                let sha = '';
                const getRes = await fetch(apiUrl, {
                    headers: { 'Authorization': `token ${token}` }
                });
                if (getRes.ok) {
                    const existing = await getRes.json();
                    sha = existing.sha;
                }

                // Push update to repo
                const putRes = await fetch(apiUrl, {
                    method: 'PUT',
                    headers: {
                        'Authorization': `token ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: `Auto Backup POS Eat A Bakery [${new Date().toLocaleString('id-ID')}]`,
                        content: contentEncoded,
                        sha: sha || undefined,
                        branch: branch
                    })
                });

                if (putRes.ok) {
                    alert('Data POS berhasil di-backup dan di-sync ke Repository GitHub Anda! 🚀');
                } else {
                    const errData = await putRes.json();
                    alert('Gagal Sync ke GitHub: ' + (errData.message || 'Periksa token/permission repo'));
                }
            } catch (err) {
                alert('Terjadi kesalahan saat menghubungkan ke GitHub API');
            }
        }

        // Process Checkout Functionality (With Live Google Sheet Sync)
        function processCheckout() {
            if (cart.length === 0) return;

            const subtotal = cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const discType = document.getElementById('discount-type').value;
            const discVal = parseFloat(document.getElementById('input-discount').value) || 0;
            const discount = discType === 'percent' ? (subtotal * discVal) / 100 : discVal;
            const total = Math.max(0, subtotal - discount);
            const cash = paymentMethod === 'cash' ? (parseFloat(document.getElementById('input-cash').value) || total) : total;

            const tx = {
                id: 'EAT-' + Date.now().toString().slice(-6),
                date: new Date().toLocaleString('id-ID'),
                items: [...cart],
                subtotal, discount, total, cash, change: Math.max(0, cash - total), method: paymentMethod
            };

            // Deduct finished product stock AND linked raw material stock automatically!
            cart.forEach(c => {
                const p = products.find(prod => prod.id === c.id);
                if (p) {
                    p.stock = Math.max(0, p.stock - c.qty);
                    if (p.ingredients && Array.isArray(p.ingredients)) {
                        p.ingredients.forEach(ing => {
                            const raw = rawMaterials.find(m => m.id === ing.matId);
                            if (raw) {
                                raw.stock = Math.max(0, raw.stock - (ing.qty * c.qty));
                            }
                        });
                    }
                }
            });

            transactions.unshift(tx);
            localStorage.setItem('eata_products', JSON.stringify(products));
            localStorage.setItem('eata_raw_materials', JSON.stringify(rawMaterials));
            localStorage.setItem('eata_transactions', JSON.stringify(transactions));

            // Trigger Google Sheets Auto Webhook Sync
            sendToGoogleSheet(tx);

            showReceipt(tx);
            clearCart();
            renderProducts();
        }

